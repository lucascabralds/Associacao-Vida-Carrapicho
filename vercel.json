{
  "functions": {
    "Projeto-carrapicho/server.js": {
      "runtime": "nodejs18.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/Projeto-carrapicho/server.js"
    },
    {
      "src": "/admin",
      "dest": "/Projeto-carrapicho/frontend/admin/index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/Projeto-carrapicho/frontend/admin/index.html"
    },
    {
      "src": "/evento.html",
      "dest": "/Projeto-carrapicho/frontend/evento.html"
    },
    {
      "src": "/src/(.*)",
      "dest": "/Projeto-carrapicho/frontend/src/$1"
    },
    {
      "src": "/img/(.*)",
      "dest": "/Projeto-carrapicho/frontend/img/$1"
    },
    {
      "src": "/(.*\\.(css|js|svg|png|jpg|jpeg|gif|ico))",
      "dest": "/Projeto-carrapicho/frontend/$1"
    },
    {
      "src": "/",
      "dest": "/Projeto-carrapicho/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/Projeto-carrapicho/server.js"
    }
  ]
}
