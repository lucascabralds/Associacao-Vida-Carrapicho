{
  "version": 2,
  "builds": [
    {
      "src": "Projeto-carrapicho/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/Projeto-carrapicho/api/index.js"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/Projeto-carrapicho/frontend/admin/index.html"
    },
    {
      "src": "/src/(.*)",
      "dest": "/Projeto-carrapicho/frontend/src/$1"
    },
    {
      "src": "/img/(.*)",
      "dest": "/Projeto-carrapicho/frontend/img/$1"
    },
    {
      "src": "/(.*\\.(css|js|svg|png|jpg|jpeg|gif|ico))",
      "dest": "/Projeto-carrapicho/frontend/$1"
    },
    {
      "src": "/",
      "dest": "/Projeto-carrapicho/frontend/home.html"
    },
    {
      "src": "/(.*)",
      "dest": "/Projeto-carrapicho/api/index.js"
    }
  ]
}
